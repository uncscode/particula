---
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import StudySidebar from './StudySidebar.astro';
import catalog from '../../.cache/studies.json';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';

const { sidebar } = Astro.locals.starlightRoute;
// Keep the topic entry points visible. Starlight also opens groups containing
// the current page; other sections start collapsed on each visit.
function collapseGroups(entries: typeof sidebar): typeof sidebar {
  return entries.map((entry) => entry.type === 'group'
    ? { ...entry, collapsed: entry.label !== 'Explore topics', entries: collapseGroups(entry.entries) }
    : entry);
}
---

{collapseGroups(sidebar).map((entry) => entry.label === 'Studies'
  ? <StudySidebar entry={{ label: 'Studies', slug: 'studies', items: catalog.navigation }} />
  : <SidebarSublist sublist={[entry]} />)}
<div class="md:sl-hidden"><MobileMenuFooter /></div>
