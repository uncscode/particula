---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = ['Guide', 'Examples', 'Theory', 'API', 'Contribute'];
---

<div class="particula-header">
  <SiteTitle />
  {hasSidebar ? (
    <button class="sidebar-toggle" aria-controls="starlight__sidebar" aria-expanded="true" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M9 4v16" />
      </svg>
      <span>Hide sidebar</span>
    </button>
  ) : (
    <>
      <nav class="home-navigation" aria-label="Main sections">
        {sections.map((label) => <a href={`${base}/${label.toLowerCase()}/`}>{label}</a>)}
      </nav>
      <button class="home-menu-button" popovertarget="home-navigation-menu" aria-label="Open navigation menu">Menu</button>
      <nav class="home-mobile-navigation" id="home-navigation-menu" popover aria-label="Main sections">
        {sections.map((label) => <a href={`${base}/${label.toLowerCase()}/`}>{label}</a>)}
        <ThemeSelect />
      </nav>
    </>
  )}
  <div class="header-search"><Search /></div>
  <div class="header-tools"><SocialIcons /><ThemeSelect /></div>
</div>

<script>
  function initializeSidebarToggle() {
    const button = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
    if (!button || button.dataset.ready) return;
    button.dataset.ready = 'true';
    button.hidden = false;
    const root = document.documentElement;
    function update() {
      const collapsed = root.hasAttribute('data-sidebar-collapsed');
      button!.setAttribute('aria-expanded', String(!collapsed));
      button!.querySelector('span')!.textContent = collapsed ? 'Show sidebar' : 'Hide sidebar';
    }
    update();
    button.addEventListener('click', () => {
      const collapsed = root.toggleAttribute('data-sidebar-collapsed');
      try { localStorage.setItem('particula:sidebar-collapsed', String(collapsed)); } catch {}
      update();
    });
  }
  initializeSidebarToggle();
  document.addEventListener('astro:page-load', initializeSidebarToggle);
</script>
