---
import ScienceScenes from './ScienceScenes.astro';
import { SCENES, createParticles, particleStyle, particleFill } from './hero-scenes.mjs';
// A static first frame is available before JavaScript loads.
let seed = 314159;
const random = () => ((seed = (1664525 * seed + 1013904223) >>> 0) / 4294967296);
const particles = createParticles('cloud', random);
const descriptions: Record<string,string> = {
  cloud: 'Three drifting air parcels each carry their own population of particles.',
  charge: 'Two like-charged droplets repel. Oppositely charged droplets touch and coalesce into one neutral droplet.',
  condensation: 'Vapor converges on growing droplets as they settle.',
  scavenging: 'Droplets settle through an aerosol and collect small particles along their paths.',
};
---

<particle-cloud data-motion="paused" data-scene="cloud">
  <div class="hero-art">
  <svg class="cloud-art" viewBox={SCENES.find(({ id }) => id === 'cloud')!.viewBox} role="img" aria-labelledby="particle-cloud-title">
    <title id="particle-cloud-title">{descriptions.cloud}</title>
    <defs>
      <radialGradient id="cloud-haze">
        <stop stop-color="var(--cloud-haze)" stop-opacity=".19" />
        <stop offset="1" stop-color="var(--cloud-haze)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="cloud-teal" cx="32%" cy="24%" r="78%">
        <stop stop-color="var(--cloud-highlight)" />
        <stop offset=".5" stop-color="var(--cloud-teal)" />
        <stop offset="1" stop-color="var(--cloud-shadow)" stop-opacity=".8" />
      </radialGradient>
      <radialGradient id="cloud-gold" cx="30%" cy="25%" r="80%">
        <stop stop-color="#fff0bd" /><stop offset=".5" stop-color="#d7bb75" /><stop offset="1" stop-color="#8d7040" stop-opacity=".8" />
      </radialGradient>
    </defs>
    <g class="moving-field">
    <g class="backdrop parcels">
      {[0,1,2].map(i=><g transform={`translate(${118+138*i} ${218-40*i})`}>
        <path class="parcel-face" d="M0 0 l17 -14 h111 l-17 14 Z M111 0 l17 -14 v99 l-17 14 Z" />
        <path class="parcel-front" d="M0 0 h111 v99 H0 Z" />
        <path class="guide-line" d="M0 99 l17 -14 V-14 M17 85 h111" stroke-dasharray="3 5"/>
      </g>)}
    </g>
    <g class="backdrop pairs">
      {[208,409].map(x=><g transform={`translate(${x} 238)`}>
        <ellipse class="guide-line" rx="89" ry="67" stroke-dasharray="3 6" />
        <path class="guide-line" d="M-69 0 H69" />
      </g>)}
    </g>
    <g class="backdrop pairs" transform="translate(409 238)">
      <circle class="collision-product" r={16*Math.cbrt(2)} fill="url(#cloud-teal)" />
    </g>
    <g class="backdrop uptake">
      <ellipse class="guide-line" cx="330" cy="252" rx="132" ry="101" stroke-dasharray="2 6" />
      <g class="guide-line"><path d="M143 182 Q165 192 186 218 m-10 -3 10 3 -1 -10 M503 182 Q477 191 460 218 m1 -10 -1 10 10 -3"/></g>
    </g>
    <g class="backdrop collection">
      {[180,225,270,315,360,405,450].map(x=><path class="guide-line" d={`M${x} 102 V393`} stroke-dasharray="2 8"/>)}
      <path class="leader" d="M493 185 v89 m-6 -9 6 9 6 -9"/>
    </g>
    <g class="cloud-core">
      {particles.map((p) => <g class="particle-anchor" transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`} opacity={p.opacity.toFixed(2)} style={particleStyle(p)}>
        <g class="particle-settling"><g class="cloud-particle" data-kind={p.kind}>
          <circle r={p.r.toFixed(1)} fill={particleFill(p)} />
          <text class="charge-sign" text-anchor="middle" dominant-baseline="central" aria-hidden="true">{p.sign}</text>
        </g></g>
      </g>)}
    </g>
    </g>
  </svg>
  <ScienceScenes />
  </div>
  <select class="scene-picker" aria-label="Homepage illustration" hidden>
    {SCENES.map(({ id, label }) => <option value={id} data-description={descriptions[id]}>{label}</option>)}
  </select>
  <span class="scene-caption" title="Process-inspired illustration">Cloud parcels</span>
  <button class="cloud-motion-toggle" hidden aria-label="Pause particle motion" title="Pause particle motion" aria-pressed="false">
    <span class="motion-symbol" aria-hidden="true">Ⅱ</span>
  </button>
</particle-cloud>

<script>
  import { SCENES, nextScene, createParticles, particleStyle, particleFill } from './hero-scenes.mjs';
  class ParticleCloud extends HTMLElement {
    connectedCallback() {
      this.cleanup?.();
      let storage;
      try { storage = sessionStorage; } catch {}
      const picker = this.querySelector<HTMLSelectElement>('.scene-picker')!;
      const showScene = (scene: string) => {
        const entry = SCENES.find(({ id }) => id === scene)!;
        picker.value = scene;
        this.toggleAttribute('data-diagram', Boolean(entry.diagram));
        this.dataset.scene = scene;
        if (entry.diagram) return;
        const canvas = this.querySelector<SVGSVGElement>('.cloud-art')!;
        canvas.setAttribute('viewBox', entry.viewBox!);
        canvas.querySelector('title')!.textContent = picker.selectedOptions[0].dataset.description || entry.label;
        const particles = createParticles(scene);
        this.querySelectorAll<SVGGElement>('.particle-anchor').forEach((anchor, i) => {
          const p = particles[i];
          anchor.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`);
          anchor.setAttribute('opacity', p.opacity.toFixed(2));
          anchor.setAttribute('style', particleStyle(p));
          const motion = anchor.querySelector<SVGGElement>('.cloud-particle')!;
          motion.dataset.kind = p.kind;
          const circle = motion.querySelector('circle')!;
          circle.setAttribute('r', p.r.toFixed(1));
          circle.setAttribute('fill', particleFill(p));
          motion.querySelector('text')!.textContent = p.sign;
        });
      };
      showScene(this.initialized ? this.dataset.scene! : nextScene(storage));
      this.initialized = true;
      picker.hidden = false;
      const selectScene = () => { this.manuallySelected = true; showScene(picker.value); };
      picker.addEventListener('change', selectScene);
      const button = this.querySelector<HTMLButtonElement>('button')!;
      const symbol = button.querySelector('.motion-symbol')!;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let enabled = !reducedMotion.matches;
      let inView = false;
      let ready = false;
      const update = () => {
        this.dataset.motion = enabled && ready && inView && !document.hidden ? 'running' : 'paused';
        button.setAttribute('aria-pressed', String(!enabled));
        button.setAttribute('aria-label', enabled ? 'Pause particle motion' : 'Play particle motion');
        button.title = enabled ? 'Pause particle motion' : 'Play particle motion';
        symbol.textContent = enabled ? 'Ⅱ' : '▷';
      };
      button.hidden = false;
      const toggle = () => { enabled = !enabled; update(); };
      button.addEventListener('click', toggle);
      const preferenceChanged = () => { enabled = !reducedMotion.matches; update(); };
      reducedMotion.addEventListener('change', preferenceChanged);
      document.addEventListener('visibilitychange', update);
      const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; update(); });
      observer.observe(this);
      const timer = setTimeout(() => { ready = true; update(); }, 500);
      const rotationTimer = setInterval(() => {
        if (this.dataset.motion === 'running' && !this.manuallySelected && document.activeElement !== picker) showScene(nextScene(storage));
      }, 30_000);
      update();
      this.cleanup = () => {
        clearTimeout(timer);
        clearInterval(rotationTimer);
        observer.disconnect();
        picker.removeEventListener('change', selectScene);
        button.removeEventListener('click', toggle);
        reducedMotion.removeEventListener('change', preferenceChanged);
        document.removeEventListener('visibilitychange', update);
      };
    }
    initialized = false;
    manuallySelected = false;
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('particle-cloud', ParticleCloud);
</script>

<style>
  particle-cloud {
    --cloud-teal: #70cbbd;
    --cloud-highlight: #d5fff0;
    --cloud-shadow: #23796f;
    --cloud-haze: #57b9a6;
    --cloud-dust: #c9ab77;
    --cloud-positive: #efaa8c;
    --cloud-negative: #80bfdf;
    display: block;
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    min-width: 0;
    pointer-events: none;
  }
  :global([data-theme='light']) particle-cloud {
    --cloud-teal: #2f9f90;
    --cloud-highlight: #cbf4e6;
    --cloud-shadow: #18574d;
    --cloud-haze: #4caa94;
    --cloud-dust: #90703e;
    --cloud-positive: #b75b40;
    --cloud-negative: #357eaa;
  }
  .backdrop {display:none}
  [data-scene='cloud'] .parcels, [data-scene='charge'] .pairs,
  [data-scene='condensation'] .uptake, [data-scene='scavenging'] .collection {display:block}
  .parcel-face,.parcel-front {stroke:var(--cloud-teal);stroke-width:1.4;fill:var(--cloud-teal);fill-opacity:.09}
  .parcel-front {fill-opacity:.045}
  .guide-line,.leader {stroke:var(--cloud-teal);stroke-width:1.4;fill:none;opacity:.38}
  .leader {stroke:var(--cloud-dust);opacity:.75}
  [data-scene='cloud'] .moving-field {animation:parcel-drift 11s ease-in-out infinite alternate paused}
  [data-motion='running'][data-scene='cloud'] .moving-field {animation-play-state:running}
  @keyframes parcel-drift {from {transform:translate(-6px,4px)} to {transform:translate(7px,-5px)}}
  .charge-sign { fill: var(--sl-color-bg); font: 600 18px system-ui; }
  [data-diagram] .cloud-art, .scene-picker:not([hidden]) + .scene-caption { display: none; }
  .scene-picker {
    appearance: none;
    pointer-events: auto;
    z-index: 2;
    padding: .35rem 1.1rem .35rem .2rem;
    border: 0;
    background: var(--sl-color-bg) radial-gradient(circle, var(--cloud-teal) 50%, transparent 65%) right .2rem center / .48rem .48rem no-repeat;
    cursor: pointer;
    font-family: inherit;
    text-align: right;
    text-align-last: right;
  }
  .scene-picker:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .scene-picker, .scene-caption { position: absolute; right: 3.5rem; bottom: .2rem; color: var(--sl-color-gray-2); font-size: .75rem; letter-spacing: .02em; }
  .hero-art { position:absolute; inset:-8% -12% 2.5rem; }
  .hero-art :global(svg[role='img']) { position:absolute; inset:0; width:100%; height:100%; }
  @media (min-width:50rem) {
    /* Cross the grid gap and overlap the copy by about an eighth of the stage. */
    particle-cloud { --art-overhang: calc(12% - .375rem); }
    .hero-art { inset:calc(0px - var(--art-overhang)) -36% calc(0px - var(--art-overhang)) calc(-19.5% - 1.72rem); }
    .cloud-motion-toggle, .scene-picker, .scene-caption {
      top: calc(100% + var(--art-overhang) + .25rem);
      bottom: auto;
    }
    .scene-picker, .scene-caption { margin-top:.6rem; }
  }
  @media (max-width:49.999rem) {
    .hero-art { inset:-6% max(-.8rem, -3.5vw) 2.2rem; }
  }
  .cloud-particle { animation: cloud-drift var(--duration) ease-in-out var(--phase) infinite; animation-play-state: paused; }
  [data-scene='charge'] .cloud-core .cloud-particle { animation-name: charge-drift; }
  [data-scene='condensation'] [data-kind='droplet'] { animation-name: droplet-grow; }
  [data-scene='condensation'] [data-kind='vapor'] { animation-name: vapor-uptake; animation-timing-function: linear; }
  [data-scene='condensation'] .particle-settling { animation: droplet-settle 30s linear var(--settle-phase) infinite; animation-play-state: paused; }
  [data-scene='scavenging'] [data-kind='collector'] { animation-name: collector-fall; animation-timing-function: linear; }
  [data-scene='scavenging'] [data-kind='captured'] { animation-name: scavenged; animation-timing-function: linear; }
  [data-motion='running'] .cloud-particle, [data-motion='running'] .particle-settling { animation-play-state: running; }
  @keyframes cloud-drift {
    0%, 100% { transform: translate(0, 0); }
    35% { transform: translate(var(--dx), var(--dy)); }
    70% { transform: translate(calc(var(--dx) * -.5), calc(var(--dy) * .6)); }
  }

  [data-scene='charge'] .cloud-core [data-kind='collision-partner'] { animation-name:collide; }
  [data-scene='charge'] .collision-product { animation:coalesce 8s ease-in-out infinite paused; }
  [data-motion='running'][data-scene='charge'] .collision-product { animation-play-state:running; }
  @keyframes collide {
    0%, 12% { transform:translateX(0); opacity:1; }
    44% { transform:translateX(var(--dx)); opacity:1; }
    54%, 93% { transform:translateX(calc(var(--dx) * 1.38)); opacity:0; }
    94% { transform:translateX(0); opacity:0; }
    100% { transform:translateX(0); opacity:1; }
  }
  @keyframes coalesce {
    0%, 44% { transform:scale(.75); opacity:0; }
    54% { transform:scale(1); opacity:1; }
    85% { transform:translate(11px,-5px); opacity:1; }
    94%,100% { transform:translate(15px,-7px); opacity:0; }
  }
  @keyframes charge-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(var(--dx), var(--dy)); }
  }
  @keyframes droplet-grow {
    0% { transform: translate(0, 0) scale(.55); opacity: 0; }
    12% { opacity: 1; }
    80% { transform: translate(var(--dx), var(--dy)) scale(1.65); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(1.65); opacity: 0; }
  }
  @keyframes vapor-uptake {
    0% { transform: translate(0, 0); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(.2); opacity: 0; }
  }
  @keyframes droplet-settle {
    0% { transform: translateY(0); opacity: 0; }
    10% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateY(var(--fall)); opacity: 0; }
  }
  @keyframes collector-fall {
    0% { transform: translateY(0) scale(.85); opacity: 0; }
    8%, 92% { opacity: 1; }
    100% { transform: translateY(300px) scale(1.15); opacity: 0; }
  }
  @keyframes scavenged {
    0%, 8% { transform: translateY(6px) scale(.25); opacity: 0; }
    12%, 97% { transform: translateY(0) scale(1); opacity: 1; }
    100% { transform: translateY(6px) scale(.25); opacity: 0; }
  }
  .cloud-motion-toggle { position: absolute; right: 0; bottom: -.5rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 50%; color: var(--sl-color-gray-2); background: color-mix(in srgb, var(--sl-color-bg) 85%, transparent); font: inherit; font-size: 1rem; pointer-events: auto; cursor: pointer; z-index: 2; }
  .cloud-motion-toggle[hidden] { display: none; }
  .cloud-motion-toggle:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-3); }
  @media (max-width: 49.999rem) {
    particle-cloud { width: min(100%, 28rem); height: clamp(17rem, 58vw, 20rem); aspect-ratio: auto; margin-inline: auto; }
    .cloud-motion-toggle { bottom: -.5rem; }
  }
  @media print { .cloud-particle, .particle-settling { animation: none !important; } .cloud-motion-toggle { display: none; } }
</style>
