---
import { createParticles, particleStyle, particleFill } from './hero-scenes.mjs';
// A static first frame is available before JavaScript loads.
let seed = 314159;
const random = () => ((seed = (1664525 * seed + 1013904223) >>> 0) / 4294967296);
const particles = createParticles('cloud', random);
const wisps = Array.from({ length: 32 }, (_, i) => {
  const y = 350 + i * 17;
  return { x: 495 + Math.sin(i * .27) * 65 + random() * 65, y, r: 1.2 + random() * 2.8, opacity: .36 * (1 - i / 36), phase: -random() * 30 };
});
---

<particle-cloud data-motion="paused" data-scene="cloud">
  <svg class="cloud-art" viewBox="0 0 600 600" role="img" aria-labelledby="particle-cloud-title">
    <title id="particle-cloud-title">A loose cloud of aerosol particles, with small teal particles and larger droplets</title>
    <defs>
      <radialGradient id="cloud-haze">
        <stop stop-color="var(--cloud-haze)" stop-opacity=".19" />
        <stop offset="1" stop-color="var(--cloud-haze)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="cloud-teal" cx="32%" cy="24%" r="78%">
        <stop stop-color="var(--cloud-highlight)" />
        <stop offset=".5" stop-color="var(--cloud-teal)" />
        <stop offset="1" stop-color="var(--cloud-shadow)" stop-opacity=".8" />
      </radialGradient>
      <radialGradient id="cloud-gold" cx="30%" cy="25%" r="80%">
        <stop stop-color="#fff0bd" /><stop offset=".5" stop-color="#d7bb75" /><stop offset="1" stop-color="#8d7040" stop-opacity=".8" />
      </radialGradient>
    </defs>
    <ellipse cx="330" cy="275" rx="240" ry="185" fill="url(#cloud-haze)" />
    <ellipse cx="380" cy="320" rx="170" ry="125" fill="url(#cloud-haze)" opacity=".6" />
    <path class="dust-ground" d="M135 400 Q310 387 510 400" fill="none" stroke="var(--cloud-dust)" stroke-width="1" opacity=".25" />
    <g class="charge-field" fill="none" stroke="var(--cloud-teal)" stroke-width=".7" stroke-dasharray="3 9" opacity=".2">
      <path d="M130 180 Q330 110 535 180 M130 270 Q330 200 535 270 M130 360 Q330 290 535 360" />
    </g>
    <g class="cloud-core">
      {particles.map((p) => <g class="particle-anchor" transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`} opacity={p.opacity.toFixed(2)} style={particleStyle(p)}>
        <g class="particle-settling"><g class="cloud-particle" data-kind={p.kind}>
          <circle r={p.r.toFixed(1)} fill={particleFill(p)} />
          <text class="charge-sign" text-anchor="middle" dominant-baseline="central" aria-hidden="true">{p.sign}</text>
        </g></g>
      </g>)}
    </g>
    <g class="cloud-wisps" aria-hidden="true">
      {wisps.map((p) => <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`} opacity={p.opacity.toFixed(2)}>
        <circle class="cloud-particle" style={`--dx:14px;--dy:-12px;--duration:32s;--phase:${p.phase.toFixed(1)}s`} r={p.r.toFixed(1)} fill="var(--cloud-teal)" />
      </g>)}
    </g>
  </svg>
  <span class="scene-caption" title="Process-inspired illustration">Cloud drift</span>
  <button class="cloud-motion-toggle" hidden aria-label="Pause particle motion" title="Pause particle motion" aria-pressed="false">
    <span class="motion-symbol" aria-hidden="true">Ⅱ</span>
  </button>
</particle-cloud>

<script>
  import { SCENES, nextScene, createParticles, particleStyle, particleFill } from './hero-scenes.mjs';
  class ParticleCloud extends HTMLElement {
    connectedCallback() {
      this.cleanup?.();
      if (!this.initialized) {
        let storage;
        try { storage = sessionStorage; } catch {}
        const scene = nextScene(storage);
        this.dataset.scene = scene;
        const label = SCENES.find(({ id }) => id === scene)!.label;
        this.querySelector('.scene-caption')!.textContent = label;
        this.querySelector('title')!.textContent = `${label}: a process-inspired particle illustration`;
        const particles = createParticles(scene);
        this.querySelectorAll<SVGGElement>('.particle-anchor').forEach((anchor, i) => {
          const p = particles[i];
          anchor.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`);
          anchor.setAttribute('opacity', p.opacity.toFixed(2));
          anchor.setAttribute('style', particleStyle(p));
          const motion = anchor.querySelector<SVGGElement>('.cloud-particle')!;
          motion.dataset.kind = p.kind;
          const circle = motion.querySelector('circle')!;
          circle.setAttribute('r', p.r.toFixed(1));
          circle.setAttribute('fill', particleFill(p));
          motion.querySelector('text')!.textContent = p.sign;
        });
        this.querySelectorAll<SVGCircleElement>('.cloud-wisps circle').forEach((circle) => {
          circle.style.setProperty('--phase', `${-Math.random() * 32}s`);
          circle.style.setProperty('--dx', `${8 + Math.random() * 20}px`);
        });
        this.initialized = true;
      }
      const button = this.querySelector<HTMLButtonElement>('button')!;
      const symbol = button.querySelector('.motion-symbol')!;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let enabled = !reducedMotion.matches;
      let inView = false;
      let ready = false;
      const update = () => {
        this.dataset.motion = enabled && ready && inView && !document.hidden ? 'running' : 'paused';
        button.setAttribute('aria-pressed', String(!enabled));
        button.setAttribute('aria-label', enabled ? 'Pause particle motion' : 'Play particle motion');
        button.title = enabled ? 'Pause particle motion' : 'Play particle motion';
        symbol.textContent = enabled ? 'Ⅱ' : '▷';
      };
      button.hidden = false;
      const toggle = () => { enabled = !enabled; update(); };
      button.addEventListener('click', toggle);
      const preferenceChanged = () => { enabled = !reducedMotion.matches; update(); };
      reducedMotion.addEventListener('change', preferenceChanged);
      document.addEventListener('visibilitychange', update);
      const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; update(); });
      observer.observe(this);
      const timer = setTimeout(() => { ready = true; update(); }, 500);
      update();
      this.cleanup = () => {
        clearTimeout(timer);
        observer.disconnect();
        button.removeEventListener('click', toggle);
        reducedMotion.removeEventListener('change', preferenceChanged);
        document.removeEventListener('visibilitychange', update);
      };
    }
    initialized = false;
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('particle-cloud', ParticleCloud);
</script>

<style>
  particle-cloud {
    --cloud-teal: #70cbbd;
    --cloud-highlight: #d5fff0;
    --cloud-shadow: #23796f;
    --cloud-haze: #57b9a6;
    --cloud-ember: #f39761;
    --cloud-smoke: #9eaaa7;
    --cloud-dust: #c9ab77;
    --cloud-positive: #efaa8c;
    --cloud-negative: #80bfdf;
    display: block;
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    min-width: 0;
    pointer-events: none;
  }
  :global([data-theme='light']) particle-cloud {
    --cloud-teal: #2f9f90;
    --cloud-highlight: #cbf4e6;
    --cloud-shadow: #18574d;
    --cloud-haze: #4caa94;
    --cloud-ember: #bc5429;
    --cloud-smoke: #6a7773;
    --cloud-dust: #90703e;
    --cloud-positive: #b75b40;
    --cloud-negative: #357eaa;
  }
  particle-cloud[data-scene='fire'] { --cloud-haze: #bd693c; --cloud-teal: var(--cloud-ember); }
  particle-cloud[data-scene='dust'] { --cloud-haze: #ac905f; --cloud-teal: var(--cloud-dust); }
  .dust-ground, .charge-field { display: none; }
  [data-scene='dust'] .dust-ground, [data-scene='charge'] .charge-field { display: block; }
  .charge-sign { fill: var(--sl-color-bg); font: 600 11px system-ui; }
  .scene-caption { position: absolute; right: 3.5rem; bottom: .2rem; color: var(--sl-color-gray-2); font-size: .75rem; letter-spacing: .02em; }
  .cloud-art { position: absolute; top: -15%; left: -20%; width: 145%; height: 145%; max-width: none; overflow: visible; }
  .cloud-particle { animation: cloud-drift var(--duration) ease-in-out var(--phase) infinite; animation-play-state: paused; }
  [data-scene='plume'] .cloud-core .cloud-particle,
  [data-scene='fire'] .cloud-core .cloud-particle { animation-name: particle-rise; animation-timing-function: linear; }
  [data-scene='dust'] .cloud-core .cloud-particle { animation-name: dust-lift; animation-timing-function: linear; }
  [data-scene='charge'] .cloud-core .cloud-particle { animation-name: charge-drift; }
  [data-scene='condensation'] [data-kind='droplet'] { animation-name: droplet-grow; }
  [data-scene='condensation'] [data-kind='vapor'] { animation-name: vapor-uptake; animation-timing-function: linear; }
  [data-scene='condensation'] .particle-settling { animation: droplet-settle 30s linear var(--settle-phase) infinite; animation-play-state: paused; }
  [data-scene='scavenging'] [data-kind='collector'] { animation-name: collector-fall; animation-timing-function: linear; }
  [data-scene='scavenging'] [data-kind='captured'] { animation-name: scavenged; animation-timing-function: linear; }
  [data-motion='running'] .cloud-particle, [data-motion='running'] .particle-settling { animation-play-state: running; }
  @keyframes cloud-drift {
    0%, 100% { transform: translate(0, 0); }
    35% { transform: translate(var(--dx), var(--dy)); }
    70% { transform: translate(calc(var(--dx) * -.5), calc(var(--dy) * .6)); }
  }
  @keyframes particle-rise {
    0% { transform: translate(0, 0) scale(.5); opacity: 0; }
    12% { opacity: 1; }
    50% { transform: translate(calc(var(--dx) * .35), calc(var(--dy) * .5)) scale(.85); }
    80% { opacity: .7; }
    100% { transform: translate(var(--dx), var(--dy)) scale(1.2); opacity: 0; }
  }
  @keyframes charge-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(var(--dx), var(--dy)); }
  }
  @keyframes dust-lift {
    0% { transform: translate(0, 0); opacity: 0; }
    12% { opacity: 1; }
    50% { transform: translate(calc(var(--dx) * .5), var(--dy)); opacity: .8; }
    100% { transform: translate(var(--dx), calc(var(--dy) * .2)); opacity: 0; }
  }
  @keyframes droplet-grow {
    0% { transform: translate(0, 0) scale(.55); opacity: 0; }
    12% { opacity: 1; }
    80% { transform: translate(var(--dx), var(--dy)) scale(1.65); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(1.65); opacity: 0; }
  }
  @keyframes vapor-uptake {
    0% { transform: translate(0, 0); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(.2); opacity: 0; }
  }
  @keyframes droplet-settle {
    0% { transform: translateY(0); opacity: 0; }
    10% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateY(var(--fall)); opacity: 0; }
  }
  @keyframes collector-fall {
    0% { transform: translateY(0) scale(.85); opacity: 0; }
    8%, 92% { opacity: 1; }
    100% { transform: translateY(300px) scale(1.15); opacity: 0; }
  }
  @keyframes scavenged {
    0%, 8% { transform: translateY(6px) scale(.25); opacity: 0; }
    12%, 97% { transform: translateY(0) scale(1); opacity: 1; }
    100% { transform: translateY(6px) scale(.25); opacity: 0; }
  }
  .cloud-motion-toggle { position: absolute; right: 0; bottom: -.5rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 50%; color: var(--sl-color-gray-2); background: color-mix(in srgb, var(--sl-color-bg) 85%, transparent); font: inherit; font-size: 1rem; pointer-events: auto; cursor: pointer; z-index: 2; }
  .cloud-motion-toggle[hidden] { display: none; }
  .cloud-motion-toggle:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-3); }
  @media (min-width: 64rem) {
    .cloud-art { top: -45%; left: -85%; width: 220%; height: 220%; }
  }
  @media (max-width: 49.999rem) {
    particle-cloud { width: min(100%, 23rem); height: 16rem; aspect-ratio: auto; margin-inline: auto; }
    .cloud-art { width: 120%; height: auto; top: -25%; left: -10%; }
    .cloud-wisps { display: none; }
    .cloud-motion-toggle { bottom: -.5rem; }
  }
  @media print { .cloud-particle, .particle-settling { animation: none !important; } .cloud-motion-toggle { display: none; } }
</style>
