<line x1="54.06" y1="245.00" x2="54.06" y2="249.00" stroke="#243E43" stroke-width="0.85" stroke-dasharray="none"/>
<text x="54.06" y="262.00" font-size="11" font-weight="400" fill="#243E43" text-anchor="middle">30</text>
<line x1="93.45" y1="245.00" x2="93.45" y2="249.00" stroke="#243E43" stroke-width="0.85" stroke-dasharray="none"/>
<text x="93.45" y="262.00" font-size="11" font-weight="400" fill="#243E43" text-anchor="middle">50</text>
<line x1="146.90" y1="245.00" x2="146.90" y2="249.00" stroke="#243E43" stroke-width="0.85" stroke-dasharray="none"/>
<text x="146.90" y="262.00" font-size="11" font-weight="400" fill="#243E43" text-anchor="middle">100</text>
<line x1="200.35" y1="245.00" x2="200.35" y2="249.00" stroke="#243E43" stroke-width="0.85" stroke-dasharray="none"/>
<text x="200.35" y="262.00" font-size="11" font-weight="400" fill="#243E43" text-anchor="middle">200</text>
<line x1="253.79" y1="245.00" x2="253.79" y2="249.00" stroke="#243E43" stroke-width="0.85" stroke-dasharray="none"/>
<text x="253.79" y="262.00" font-size="11" font-weight="400" fill="#243E43" text-anchor="middle">400</text>
<text x="154.00" y="282.00" font-size="14" font-weight="700" fill="#243E43" text-anchor="middle">Particle diameter at 2 h (nm)</text>
<polyline points="$frozen" fill="none" stroke="#A44D21" stroke-width="2.25" stroke-linejoin="round" stroke-dasharray="4 3"/>
<polyline points="$refit" fill="none" stroke="#135963" stroke-width="2.25" stroke-linejoin="round" stroke-dasharray="none"/>
$measurements
<rect x="43" y="125" width="112" height="46" fill="#FBF2E3"/>
<g transform="translate(0 -19)">
<text x="44" y="155" font-size="11" font-weight="700">Particula</text>
<line x1="45.00" y1="169.00" x2="59.00" y2="169.00" stroke="#A44D21" stroke-width="2" stroke-dasharray="4 3"/>
<text x="62" y="173" font-size="11" font-weight="400" fill="#A44D21" text-anchor="start">Bulk-fit chemistry</text>
<line x1="45.00" y1="183" x2="58" y2="183" stroke="#135963" stroke-width="2.3" stroke-dasharray="none"/>
