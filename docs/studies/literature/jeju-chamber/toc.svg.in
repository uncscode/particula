<svg xmlns="http://www.w3.org/2000/svg" width="3in" height="3in" viewBox="0 0 300 300" role="img" aria-labelledby="title desc">
  <title id="title">Jeju Island Chamber</title>
  <desc id="desc">A sampling tube draws from a cloud inside K-CPEC. For the unsalted ambient-air run, the measured and simulated record-mean spectra share a droplet peak. The six-run fit undercounts the smaller side of the peak. Both curves group the 70 optical bins into 18 bands, conserving particle number.</desc>
  <rect width="300" height="300" fill="#FBF2E3"/>
  <g stroke-linejoin="round" stroke-linecap="round">
    <path d="M16 18 Q16 12 25 10 Q50 5 75 10 Q83 12 83 18 V54 Q82 62 50 63 Q17 62 16 54Z" fill="#CAD9D2" stroke="#243E43" stroke-width="2"/>
    <path d="M18 16 Q50 24 81 16" fill="none" stroke="#617679" stroke-width="1.3"/>
    <path d="M35 39 C28 39 27 30 35 28 C36 21 47 20 51 26 C57 21 65 25 65 30 C74 31 72 39 65 39Z" fill="#FFF9EC" stroke="#315F65" stroke-width="1.45"/>
    <path d="M75 35V64Q75 68 79 68H87 M83 65L87 68L83 71" fill="none" stroke="#135963" stroke-width="1.8"/>
  </g>
  <g font-family="DejaVu Sans, sans-serif" fill="#243E43">
    <text x="47" y="55" text-anchor="middle" font-size="12.5" font-weight="bold">K-CPEC</text>
    <text x="92" y="31" font-size="17.5" font-weight="bold">Jeju Island Chamber</text>
    <text x="92" y="51" font-size="13">Run 1 · Unsalted ambient air</text>
    <text x="92" y="71" fill="#135963" font-size="11">Cloud sample</text>
    <g font-size="12.5">
      <path d="M36 83H58" stroke="#243E43" stroke-width="2.5"/><text x="64" y="87">Measured</text>
      <path d="M163 83H186" stroke="#135963" stroke-width="2.5" stroke-dasharray="5 3"/><text x="192" y="87">Simulated</text>
    </g>
    <text x="51" y="112" font-size="12">Particles/cm³ per decade of diameter</text>
    <g fill="none" stroke="#CFD3C8" stroke-width="0.8"><path d="M51 124H282 M51 162H282 M51 200H282"/></g>
    <path d="M51 124V238H282" fill="none" stroke="#617679" stroke-width="1"/>
    <g id="spectra" fill="none" stroke-width="2.2" stroke-linejoin="round">
      <path id="measured" stroke="#243E43" d="M51 238.000V238.000H64.200V238.000H77.400V237.993H90.600V237.612H103.800V237.115H117.000V235.397H130.200V233.527H143.400V226.609H156.600V199.614H169.800V182.292H183.000V148.380H196.200V183.855H209.400V228.317H222.600V237.845H235.800V237.999H249.000V237.999H262.200V238.000H275.400V238.000H282.000"/>
      <path id="shared" stroke="#135963" stroke-dasharray="5 2.5" d="M51 237.861V237.861H64.200V237.761H77.400V237.669H90.600V237.359H103.800V236.944H117.000V236.269H130.200V234.268H143.400V228.498H156.600V219.367H169.800V193.865H183.000V164.320H196.200V190.971H209.400V228.369H222.600V237.529H235.800V237.998H249.000V238.000H262.200V238.000H275.400V238.000H282.000"/>
    </g>
    <g font-size="11" text-anchor="end">
      <text x="45" y="128">600</text><text x="45" y="166">400</text>
      <text x="45" y="204">200</text><text x="45" y="242">0</text>
    </g>
    <g id="diameter-ticks" font-size="11" text-anchor="middle">
      <path d="M67.470 238v4" stroke="#617679"/><text x="67.470" y="256">1</text>
      <path d="M117.854 238v4" stroke="#617679"/><text x="117.854" y="256">3</text>
      <path d="M173.070 238v4" stroke="#617679"/><text x="173.070" y="256">10</text>
      <path d="M223.454 238v4" stroke="#617679"/><text x="223.454" y="256">30</text>
      <path d="M278.670 238v4" stroke="#617679"/><text x="278.670" y="256">100</text>
    </g>
    <text x="162" y="278" text-anchor="middle" font-size="13">Optical diameter (µm)</text>
  </g>
  <g transform="translate(266,272)">$dots</g>
</svg>
