<svg xmlns="http://www.w3.org/2000/svg" width="3in" height="3in" viewBox="0 0 300 300" role="img" aria-labelledby="title desc">
  <title id="title">Particula sizes a 100.7 nm PSL standard at about 102 nm near atmospheric pressure</title>
  <desc id="desc">On an expanded diameter ruler, the 100.7 nm polystyrene latex standard lies to the left of the roughly 102 nm inferred from the two near-atmospheric mobility observations using the paper’s gas properties.</desc>
  <rect width="300" height="300" fill="#fbf2e3"/>
  <g font-family="sans-serif" font-weight="600">
    <circle cx="68.00" cy="82.00" r="36.00" fill="#cad9d2" stroke="#243e43" stroke-width="3"/>
    <path d="M44 80q2-14 15-21" fill="none" stroke="#fbf2e3" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
    <line x1="32.00" y1="164.00" x2="268.00" y2="164.00" stroke="#243e43" stroke-width="3" />
    <line x1="32.00" y1="164.00" x2="32.00" y2="178.00" stroke="#243e43" stroke-width="2" />
    <line x1="51.67" y1="164.00" x2="51.67" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="71.33" y1="164.00" x2="71.33" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="91.00" y1="164.00" x2="91.00" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="110.67" y1="164.00" x2="110.67" y2="178.00" stroke="#243e43" stroke-width="2" />
    <line x1="130.33" y1="164.00" x2="130.33" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="150.00" y1="164.00" x2="150.00" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="169.67" y1="164.00" x2="169.67" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="189.33" y1="164.00" x2="189.33" y2="178.00" stroke="#243e43" stroke-width="2" />
    <line x1="209.00" y1="164.00" x2="209.00" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="228.67" y1="164.00" x2="228.67" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="248.33" y1="164.00" x2="248.33" y2="170.00" stroke="#243e43" stroke-width="2" />
    <line x1="268.00" y1="164.00" x2="268.00" y2="178.00" stroke="#243e43" stroke-width="2" />
